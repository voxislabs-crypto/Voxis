PORT=3101

# Clerk auth — required in production (all keys must share the same environment: test or live).
# Get keys from https://dashboard.clerk.com → API Keys.
# Enable Google under User & Authentication → Social Connections.
CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Optional: comma-separated Clerk user IDs allowed to change LLM settings.
# ADMIN_CLERK_IDS=
# Local-only bypass — never set true in production.
# ALLOW_MISSING_CLERK_KEYS=true

LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=meta-llama/llama-3.3-8b-instruct:free
MOOD_ADJUDICATION_ENABLED=true
PERSONA_PROMPT_CHAR_BUDGET=6500
PERSONA_PROMPT_CHAR_BUDGET_DEFAULT=
PERSONA_PROMPT_CHAR_BUDGET_NARRATIVE_ANTAGONIST=
PERSONA_PROMPT_CHAR_BUDGET_ANTI_HERO=
PERSONA_PROMPT_CHAR_BUDGET_MORALLY_COMPLEX=
PERSONA_PROMPT_CHAR_BUDGET_TRAGIC_VILLAIN=
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
RESEARCH_TIMEOUT_MS=12000
TTS_API_KEY=
TTS_BASE_URL=https://openrouter.ai/api/v1
TTS_MODEL=openai/tts-1
TTS_DEFAULT_VOICE=alloy
TTS_RESPONSE_FORMAT=mp3
# Engine selection: "auto" tries configured engines in priority order (recommended for resilience).
# Set to a specific engine (cartesia, cloud, piper, kokoro) only when you want to pin one provider.
TTS_ENGINE=auto
# Debug provider lock: when true, restricts allowed engines to kokoro and cartesia only.
# Set false in production unless you specifically want to lock out cloud/piper/elevenlabs.
TTS_DEBUG_PROVIDER_LOCK=false
# Backend guard timeout for /personality/:id/tts requests (ms). Lower than nginx proxy_read_timeout
# so Voxis returns JSON diagnostics before nginx returns an opaque HTML 502 page.
TTS_REQUEST_TIMEOUT_MS=12000
PIPER_COMMAND=/usr/local/bin/piper
PIPER_MODEL_PATH=/opt/piper/models/en_US-lessac-medium.onnx
PIPER_SPEAKER=
# Freesound.org API key — used for dynamic CC-licensed mood loop caching
# Register at: https://freesound.org/apiv2/apply
FREESOUND_API_KEY=
