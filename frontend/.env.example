# Required for production builds — publishable key only (never put the secret key here).
# Get from https://dashboard.clerk.com → API Keys → Publishable key.
# Must match backend Clerk environment (pk_test with sk_test, or pk_live with sk_live).
VITE_CLERK_PUBLISHABLE_KEY=pk_live_XXXXXXXXXXXXXXXX

# Enable Google sign-in in Clerk Dashboard:
# User & Authentication → Social Connections → Google → Enable
# Add your production domain under Clerk → Domains (e.g. voxis.voxislabs.com).

VITE_NEURAL_CORE_ENABLED=true